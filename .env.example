# AirStudio server configuration — copy to ".env" or set as environment variables.
# Everything is optional: with none of these set, the app runs in demo mode.

PORT=3000

# Signs every license key (AIRS-XXXX-XXXX-XXXX). Set once, keep forever, never commit the real value.
LICENSE_SECRET=change-me-to-a-long-random-secret

# Owner lifetime key(s), comma-separated. Keys listed here always activate
# Premium, independent of LICENSE_SECRET rotation. Example:
# OWNER_LICENSE_KEYS=AIRS-OWNER-STAN-2026
OWNER_LICENSE_KEYS=

# production disables demo keys + demo checkout
NODE_ENV=development

# Public URL where Paystack redirects buyers back after payment, e.g. https://airstudio.yourdomain.com
BASE_URL=

# Static-only hosts (e.g. the Vercel deployment) cannot hold WebSocket
# connections, so their clients open signaling at this URL instead.
# Set to your persistent server, e.g. https://airstudio.onrender.com
SIGNAL_URL=

# Paystack (Nigeria payments — see docs/PAYSTACK_SETUP.md). Leave blank to stay in demo-checkout mode.
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_PRICE_MONTHLY=49900
PAYSTACK_PRICE_YEARLY=299900
PAYSTACK_PRICE_LIFETIME=599900
